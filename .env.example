# Enables the separate synthetic demo walkthrough and report.
DEMO_MODE=true

# Real public npm metadata, verified archives, and static comparison.
# No package code runs. Disable this independently of the demo.
STATIC_ANALYSIS_ENABLED=true

# Operator worker only. The web application never starts containers.
# Run on a dedicated disposable Linux Docker host/VM, not a secrets-bearing host.
RUNTIME_PROBE_ENABLED=false
# Immutable local image ID from: docker image inspect dependencyguard-probe:local
SANDBOX_IMAGE_ID=

# Optional paid AI requests, only after clicking Generate with Nebius.
AI_INVESTIGATION_ENABLED=false
NEBIUS_API_KEY=
# Exact model ID from your Nebius account; choose a Nemotron model with JSON support.
NEBIUS_MODEL=
